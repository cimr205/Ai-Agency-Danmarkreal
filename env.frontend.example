VITE_API_BASE_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Sentry error monitoring (optional; monitoring is off when the DSN is empty) ---
VITE_SENTRY_DSN=
# Defaults to VERCEL_ENV (production/preview/development), else the Vite mode.
VITE_SENTRY_ENVIRONMENT=
# Defaults to VERCEL_GIT_COMMIT_SHA.
VITE_SENTRY_RELEASE=
# 0..1, defaults to 0.05 (5% of page loads/navigations).
VITE_SENTRY_TRACES_SAMPLE_RATE=
# Build-time only (never VITE_-prefixed, never shipped to the browser):
# source maps are uploaded when all three are set.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
