# ORIGIN Automation Engine: names only, NEVER real values.
# Copy to .env for local operator scripts (.env is git-ignored). Most secrets do not belong
# in a local .env at all; see SECRETS.md for where each one lives.

# --- Local operator scripts (backup/, tests/). Leave empty when not running them. ---
# Admin connection for migrations and backups. Read it from Railway instead of storing it:
#   railway variables -s Postgres --json  ->  DATABASE_PUBLIC_URL
SOURCE_URL=
DBURL=
# Isolated restore target (local, empty database). Never production.
TARGET_URL=

# --- These live in n8n Credentials, NOT here (listed so the names are known) ---
# Railway Postgres - origin_app   (Postgres: host, port, database, user origin_app, password)
# OpenRouter API key              (OpenRouter credential / Header Auth "Authorization: Bearer ...")
# Meta app                        (Facebook Graph API (App): app secret + access token)
# Meta per-account page/IG tokens (one Facebook Graph API credential per connected brand account)

# --- These live in Railway Variables (server-only), NOT here ---
# POSTGRES_PASSWORD / PGPASSWORD / DATABASE_URL / DATABASE_PUBLIC_URL   (service Postgres, managed by Railway)
# ORIGIN_BACKUP_*   (backup destination credentials, once a scheduled backup runner exists)
