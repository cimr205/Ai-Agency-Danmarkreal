# ─────────────────────────────────────────────────────────────────────────────
# Mastra E2E (QA-1) — DEDICATED NON-PRODUCTION TEST PROJECT credentials.
#
# Copy this file to `.env.e2e.local` (gitignored) and fill the values. NEVER put
# production URLs/keys here. The guards refuse production and require the
# acknowledgement flag below.
#
# New Supabase projects issue NEW API keys. Map them like this:
#   • Publishable key  (sb_publishable_...)  → TEST_SUPABASE_ANON_KEY
#   • Secret key       (sb_secret_...)       → TEST_SUPABASE_SERVICE_ROLE_KEY
# Legacy JWT keys (anon / service_role, "eyJ…") also work if your project still
# exposes them — put them in the same two variables.
# ─────────────────────────────────────────────────────────────────────────────

# Test project API endpoint, e.g. https://<test-ref>.supabase.co
TEST_SUPABASE_URL=

# Publishable key (sb_publishable_...) OR legacy anon JWT
TEST_SUPABASE_ANON_KEY=

# Secret key (sb_secret_...) OR legacy service_role JWT — admin provisioning/cleanup only
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string of the TEST project (for applying migrations)
# e.g. postgresql://postgres.<ref>:<db-password>@<host>:5432/postgres
TEST_SUPABASE_DB_URL=

# Test project ref (the <ref> in the URL) — used for `supabase link`/db push and host checks
TEST_SUPABASE_PROJECT_REF=

# Explicit acknowledgement that the above is a DEDICATED non-production project.
E2E_ALLOW_TEST_PROJECT=1

# ── Production identifiers, used ONLY so the guard can prove test != production ──
# Fill these with the PRODUCTION project's URL and ref so step-4 host/ID comparison
# can run. (Values are only compared for inequality; never written to.)
PROD_SUPABASE_URL=
PROD_SUPABASE_PROJECT_ID=

# Optional: isolated frontend port for the UI smoke (do NOT reuse :8080)
E2E_APP_BASE_URL=http://localhost:8091
